<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="viewport" content="width=device-width,initial-scale=1"><style>/* 使用系统字体作为回退，确保文本始终可见 */
      html, body {
        font-family: 'Manrope-Regular', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size-adjust: 0.54;
        overflow-x: hidden;
        max-width: 100vw;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      *, *::before, *::after {
        box-sizing: inherit;
      }

      /* ===== 移动端关键布局（非 scoped，始终生效） ===== */
      /* 使用 max-device-width 防御浏览器后退时视口短暂变宽的问题 */
      /* max-device-width 基于设备物理宽度，不受视口临时变化影响 */
      @media screen and (max-device-width: 768px), screen and (max-width: 768px) {
        /* --- PersonalCenter 布局 --- */
        .personal-center-layout {
          flex-direction: column !important;
          height: auto !important;
          width: 100% !important;
          max-width: 100vw !important;
          overflow-x: hidden !important;
        }
        .personal-center-layout .main-content {
          overflow-y: visible !important;
          flex: 1 !important;
          max-width: 100% !important;
        }

        /* --- 侧边栏 --- */
        .personal-sidebar {
          width: 100% !important;
          min-height: auto !important;
          flex-shrink: 1 !important;
        }

        /* --- 收藏页左右布局 --- */
        .favorite-page .favorite-body,
        .favorite-page-embedded .favorite-body {
          flex-direction: column !important;
          gap: 24px !important;
        }
        .favorite-page .favorite-right,
        .favorite-page-embedded .favorite-right {
          width: 100% !important;
          max-width: 100% !important;
          flex-shrink: 1 !important;
          position: static !important;
        }

        /* --- 收藏页外容器 --- */
        .favorite-page,
        .favorite-page-embedded {
          padding-left: 16px !important;
          padding-right: 16px !important;
          max-width: 100vw !important;
          overflow-x: hidden !important;
        }

        /* --- 询盘表单 --- */
        .intention-form-section {
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
        }
        .intention-form {
          text-align: center !important;
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
        }
        .intention-form .el-form-item,
        .intention-form .el-form-item__content {
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
          text-align: center !important;
        }
        .intention-form .el-form-item__label {
          text-align: center !important;
          width: 100% !important;
        }
        .intention-form .el-input,
        .intention-form .el-textarea,
        .intention-form .el-input__inner,
        .intention-form .el-textarea__inner {
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
        }
        .intention-submit {
          width: 100% !important;
          text-align: center !important;
        }
        .intention-submit .intention-btn {
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
        }
        .intention-title,
        .intention-tip {
          text-align: center !important;
          width: 100% !important;
        }
